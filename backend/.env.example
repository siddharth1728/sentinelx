# SENTINELX Backend Configuration Template
# Copy this file to .env and configure for your local/production environment

# Application Settings
APP_NAME=SENTINELX Security Analytics Platform
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://sentinel_user:sentinel_password@localhost:5432/sentinelx_db

# Security & Alert Thresholds
INTRUSION_CONFIDENCE_THRESHOLD=0.75
ENABLE_AUTO_ALERT_CREATION=true

# ML Model Paths (relative to backend or absolute)
MODEL_DIR=../ml/models
MODEL_FILE=sentinelx_rf_model.joblib
PREPROCESSOR_FILE=preprocessor.joblib
METADATA_FILE=model_metadata.json

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
